{
  "name": "firehawk-cms",
  "version": "1.0.0",
  "description": "Video CMS with grid/reel presentation templates and MongoDB backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "css:build": "npx tailwindcss -i ./src/css/input.css -o ./public/css/styles.css",
    "css:watch": "npx tailwindcss -i ./src/css/input.css -o ./public/css/styles.css --watch",
    "build": "npm run css:build",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@mux/mux-node": "^12.8.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "keywords": [
    "cms",
    "video",
    "mux",
    "mongodb",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
