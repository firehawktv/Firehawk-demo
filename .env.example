# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
# Local: mongodb://localhost:27017/firehawk
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/firehawk
MONGODB_URI=mongodb://localhost:27017/firehawk

# Mux API Credentials
# Get these from https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
