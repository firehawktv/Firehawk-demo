<%- include('../../partials/admin-header') %>

<!-- Header -->
<div class="mb-6">
  <a href="/admin/presentations" class="text-gray-400 hover:text-white flex items-center mb-4">
    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to Presentations
  </a>
  <h1 class="text-3xl font-bold text-white"><%= presentation ? 'Edit Presentation' : 'Create Presentation' %></h1>
  <% if (presentation) { %>
    <p class="mt-2 text-gray-400">
      Public URL: <a href="/p/<%= presentation.slug %>" target="_blank" class="text-blue-400 hover:underline">/p/<%= presentation.slug %></a>
    </p>
  <% } %>
</div>

<!-- Error Message -->
<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-6 p-4 rounded-lg bg-red-900 text-red-300">
    <%= error %>
  </div>
<% } %>

<!-- Form -->
<form action="<%= action %>" method="<%= method %>" enctype="multipart/form-data" class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Client Info -->
      <div class="bg-gray-800 rounded-lg shadow p-6">
        <h2 class="text-lg font-medium text-white mb-4">Client Information</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="client" class="block text-sm font-medium text-gray-300 mb-1">Client Name *</label>
            <input type="text" name="client" id="client" required
                   value="<%= presentation ? presentation.client : '' %>"
                   class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
                   placeholder="Company or client name">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1">Client Logo</label>
            <input type="url" name="clientLogo" id="clientLogo"
                   value="<%= presentation ? (presentation.clientLogo && !presentation.clientLogo.startsWith('/uploads') ? presentation.clientLogo : '') : '' %>"
                   class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400 mb-2"
                   placeholder="https://example.com/logo.png">
            <div class="text-gray-500 text-xs text-center mb-2">— or upload —</div>
            <input type="file" name="clientLogoFile" id="clientLogoFile" accept="image/*"
                   class="w-full text-gray-400 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-gray-700 file:text-gray-300 hover:file:bg-gray-600">
            <% if (presentation && presentation.clientLogo) { %>
              <div class="mt-2 flex items-center gap-2">
                <img src="<%= presentation.clientLogo %>" alt="Current logo" class="h-8 object-contain bg-gray-700 rounded px-2">
                <span class="text-xs text-gray-400">Current logo</span>
              </div>
            <% } %>
          </div>
        </div>

        <div class="mt-4">
          <label for="message" class="block text-sm font-medium text-gray-300 mb-1">Message</label>
          <textarea name="message" id="message" rows="4"
                    class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
                    placeholder="Personal message for the client..."><%= presentation ? (presentation.message || '') : '' %></textarea>
        </div>
      </div>

      <!-- Video Selection -->
      <div class="bg-gray-800 rounded-lg shadow p-6">
        <h2 class="text-lg font-medium text-white mb-4">Select Videos</h2>

        <!-- Filters -->
        <div class="flex flex-wrap gap-3 mb-4">
          <div class="flex-1 min-w-[150px]">
            <select id="filter-category" onchange="filterVideos()"
                    class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm focus:ring-spindle-500 focus:border-spindle-500">
              <option value="">All Categories</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat %>"><%= cat %></option>
              <% }); %>
            </select>
          </div>
          <div class="flex-1 min-w-[150px]">
            <select id="filter-tag" onchange="filterVideos()"
                    class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm focus:ring-spindle-500 focus:border-spindle-500">
              <option value="">All Skills/Tags</option>
              <% tags.forEach(function(tag) { %>
                <option value="<%= tag %>"><%= tag %></option>
              <% }); %>
            </select>
          </div>
          <button type="button" onclick="clearFilters()" class="px-3 py-2 text-sm text-gray-400 hover:text-white">
            Clear
          </button>
        </div>

        <!-- Video List -->
        <div id="video-list" class="space-y-2 max-h-80 overflow-y-auto border border-gray-700 rounded-lg p-2">
          <% if (videos.length === 0) { %>
            <div class="text-center py-8 text-gray-400">
              <p>No videos available. <a href="/admin/videos/new" class="text-spindle-400 hover:underline">Add videos first</a></p>
            </div>
          <% } else { %>
            <% videos.forEach(function(video) { %>
              <% const isSelected = presentation && presentation.videos.some(v => v._id.toString() === video._id.toString()); %>
              <label class="video-item flex items-center p-3 rounded-lg cursor-pointer transition-colors
                            <%= isSelected ? 'bg-spindle-900 border border-spindle-500' : 'bg-gray-700 border border-transparent hover:bg-gray-600' %>"
                     data-id="<%= video._id %>"
                     data-category="<%= video.category || '' %>"
                     data-tags="<%= video.tags.join(',') %>"
                     data-title="<%= video.title || video.project %>"
                     data-client="<%= video.client %>"
                     data-embed="<%= video.embedId %>">
                <input type="checkbox" name="videos" value="<%= video._id %>"
                       <%= isSelected ? 'checked' : '' %>
                       onchange="updateSelectedList()"
                       class="h-4 w-4 text-spindle-600 focus:ring-spindle-500 bg-gray-600 border-gray-500 rounded">
                <img src="https://image.mux.com/<%= video.embedId %>/thumbnail.jpg?width=120"
                     alt="<%= video.title || video.project %>"
                     class="w-16 h-10 object-cover rounded ml-3"
                     onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%234b5563%22%3E%3Cpath d=%22M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z%22/%3E%3C/svg%3E'">
                <div class="flex-1 ml-3 min-w-0">
                  <p class="text-sm font-medium text-white truncate"><%= video.title || video.project %></p>
                  <p class="text-xs text-gray-400 truncate"><%= video.client %> · <%= video.category || 'Uncategorized' %></p>
                </div>
              </label>
            <% }); %>
          <% } %>
        </div>

        <!-- Selected Videos (drag to reorder) -->
        <div class="mt-4 border-t border-gray-700 pt-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-300">Selected Videos</h3>
            <span id="selected-count" class="text-xs text-gray-400">0 selected</span>
          </div>
          <p class="text-xs text-gray-500 mb-3">Drag to reorder. Videos will play in this order.</p>
          <div id="sortable-selected" class="space-y-2 min-h-[60px] border-2 border-dashed border-gray-700 rounded-lg p-2">
            <p id="empty-selection" class="text-center py-4 text-gray-500 text-sm">Select videos from the list above</p>
          </div>
        </div>

        <!-- Hidden inputs for video order (populated by JS) -->
        <div id="video-order-inputs"></div>
      </div>

    </div>

    <!-- Sidebar -->
    <div class="space-y-6">

      <!-- Layout Options -->
      <div class="bg-gray-800 rounded-lg shadow p-6">
        <h2 class="text-lg font-medium text-white mb-4">Layout</h2>

        <div class="space-y-3">
          <label class="flex items-center p-3 border rounded-lg cursor-pointer hover:bg-gray-700 <%= (!presentation || presentation.layout === 'grid') ? 'border-spindle-500 bg-spindle-950' : 'border-gray-600' %>">
            <input type="radio" name="layout" value="grid"
                   <%= (!presentation || presentation.layout === 'grid') ? 'checked' : '' %>
                   class="text-spindle-600 focus:ring-spindle-500 bg-gray-700 border-gray-600">
            <div class="ml-3">
              <span class="text-sm font-medium text-white">Grid</span>
              <p class="text-xs text-gray-400">3-6 videos in a responsive grid</p>
            </div>
          </label>

          <label class="flex items-center p-3 border rounded-lg cursor-pointer hover:bg-gray-700 <%= (presentation && presentation.layout === 'reel') ? 'border-spindle-500 bg-spindle-950' : 'border-gray-600' %>">
            <input type="radio" name="layout" value="reel"
                   <%= (presentation && presentation.layout === 'reel') ? 'checked' : '' %>
                   class="text-spindle-600 focus:ring-spindle-500 bg-gray-700 border-gray-600">
            <div class="ml-3">
              <span class="text-sm font-medium text-white">Reel</span>
              <p class="text-xs text-gray-400">Large player with thumbnail row</p>
            </div>
          </label>
        </div>
      </div>

      <!-- Theme Options -->
      <div class="bg-gray-800 rounded-lg shadow p-6">
        <h2 class="text-lg font-medium text-white mb-4">Theme</h2>

        <div class="space-y-3">
          <label class="flex items-center p-3 border border-gray-600 rounded-lg cursor-pointer hover:bg-gray-700">
            <input type="radio" name="theme" value="dark"
                   <%= (!presentation || presentation.theme === 'dark') ? 'checked' : '' %>
                   class="text-spindle-600 focus:ring-spindle-500 bg-gray-700 border-gray-600">
            <div class="ml-3">
              <span class="text-sm font-medium text-white">Dark</span>
            </div>
          </label>

          <label class="flex items-center p-3 border border-gray-600 rounded-lg cursor-pointer hover:bg-gray-700">
            <input type="radio" name="theme" value="light"
                   <%= (presentation && presentation.theme === 'light') ? 'checked' : '' %>
                   class="text-spindle-600 focus:ring-spindle-500 bg-gray-700 border-gray-600">
            <div class="ml-3">
              <span class="text-sm font-medium text-white">Light</span>
            </div>
          </label>
        </div>

        <div class="mt-4 space-y-3">
          <div>
            <label for="primaryColor" class="block text-sm font-medium text-gray-300 mb-1">Accent Color</label>
            <div class="flex items-center space-x-2">
              <input type="color" name="primaryColor" id="primaryColor"
                     value="<%= (presentation && presentation.primaryColor) ? presentation.primaryColor : '#6a94c7' %>"
                     class="h-10 w-16 border border-gray-600 rounded cursor-pointer bg-gray-700">
              <input type="text" id="primaryColorText"
                     value="<%= (presentation && presentation.primaryColor) ? presentation.primaryColor : '#6a94c7' %>"
                     class="flex-1 bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 text-sm font-mono"
                     onchange="document.getElementById('primaryColor').value = this.value">
            </div>
          </div>
        </div>
      </div>

      <!-- Settings -->
      <div class="bg-gray-800 rounded-lg shadow p-6">
        <h2 class="text-lg font-medium text-white mb-4">Settings</h2>

        <div class="space-y-4">
          <div>
            <label for="expiresAt" class="block text-sm font-medium text-gray-300 mb-1">Expires On</label>
            <input type="date" name="expiresAt" id="expiresAt"
                   value="<%= (presentation && presentation.expiresAt) ? new Date(presentation.expiresAt).toISOString().split('T')[0] : '' %>"
                   class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500">
            <p class="mt-1 text-xs text-gray-400">Leave blank for no expiration</p>
          </div>

          <% if (presentation) { %>
            <div class="flex items-center">
              <input type="checkbox" name="isActive" id="isActive"
                     <%= presentation.isActive ? 'checked' : '' %>
                     class="h-4 w-4 text-spindle-600 focus:ring-spindle-500 bg-gray-700 border-gray-600 rounded">
              <label for="isActive" class="ml-2 text-sm text-gray-300">Active</label>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Actions -->
      <div class="bg-gray-800 rounded-lg shadow p-6">
        <div class="space-y-3">
          <button type="submit" class="w-full px-4 py-2 bg-spindle-600 text-white rounded-lg hover:bg-spindle-700 font-medium">
            <%= presentation ? 'Update Presentation' : 'Create Presentation' %>
          </button>
          <a href="/admin/presentations" class="block w-full px-4 py-2 border border-gray-600 rounded-lg text-gray-300 hover:bg-gray-700 font-medium text-center">
            Cancel
          </a>
        </div>
      </div>

    </div>

  </div>
</form>

<!-- SortableJS -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
// Store video data for selected list
const videoData = {};
document.querySelectorAll('.video-item').forEach(item => {
  videoData[item.dataset.id] = {
    id: item.dataset.id,
    title: item.dataset.title,
    client: item.dataset.client,
    embed: item.dataset.embed
  };
});

// Initialize selected list with pre-checked videos
const selectedOrder = [];
<% if (presentation && presentation.videos) { %>
  <% presentation.videos.forEach(function(v) { %>
    selectedOrder.push('<%= v._id %>');
  <% }); %>
<% } %>

// Filter videos by category/tag
function filterVideos() {
  const cat = document.getElementById('filter-category').value.toLowerCase();
  const tag = document.getElementById('filter-tag').value.toLowerCase();

  document.querySelectorAll('.video-item').forEach(item => {
    const itemCat = (item.dataset.category || '').toLowerCase();
    const itemTags = (item.dataset.tags || '').toLowerCase().split(',');

    const matchCat = !cat || itemCat === cat;
    const matchTag = !tag || itemTags.includes(tag);

    item.style.display = (matchCat && matchTag) ? 'flex' : 'none';
  });
}

function clearFilters() {
  document.getElementById('filter-category').value = '';
  document.getElementById('filter-tag').value = '';
  filterVideos();
}

// Update selected videos list
function updateSelectedList() {
  const container = document.getElementById('sortable-selected');
  const emptyMsg = document.getElementById('empty-selection');
  const countEl = document.getElementById('selected-count');

  // Get all checked videos
  const checked = document.querySelectorAll('input[name="videos"]:checked');
  const checkedIds = Array.from(checked).map(cb => cb.value);

  // Update order: keep existing order, add new ones at end, remove unchecked
  const newOrder = selectedOrder.filter(id => checkedIds.includes(id));
  checkedIds.forEach(id => {
    if (!newOrder.includes(id)) newOrder.push(id);
  });
  selectedOrder.length = 0;
  selectedOrder.push(...newOrder);

  // Update count
  countEl.textContent = `${selectedOrder.length} selected`;

  // Clear container
  container.innerHTML = '';

  if (selectedOrder.length === 0) {
    container.innerHTML = '<p id="empty-selection" class="text-center py-4 text-gray-500 text-sm">Select videos from the list above</p>';
    return;
  }

  // Build selected items
  selectedOrder.forEach((id, index) => {
    const video = videoData[id];
    if (!video) return;

    const div = document.createElement('div');
    div.className = 'selected-item flex items-center p-2 bg-gray-700 rounded-lg';
    div.dataset.id = id;
    div.innerHTML = `
      <span class="drag-handle cursor-move text-gray-500 mr-2 text-lg">⋮⋮</span>
      <span class="text-gray-400 text-sm mr-3 w-6">${index + 1}</span>
      <img src="https://image.mux.com/${video.embed}/thumbnail.jpg?width=80"
           class="w-12 h-8 object-cover rounded"
           onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%234b5563%22%3E%3Cpath d=%22M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z%22/%3E%3C/svg%3E'">
      <div class="flex-1 ml-3 min-w-0">
        <p class="text-sm text-white truncate">${video.title}</p>
        <p class="text-xs text-gray-400 truncate">${video.client}</p>
      </div>
      <button type="button" onclick="removeVideo('${id}')" class="ml-2 text-gray-500 hover:text-red-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    `;
    container.appendChild(div);
  });

  updateVideoOrderInputs();
}

function removeVideo(id) {
  // Uncheck the checkbox
  const checkbox = document.querySelector(`input[name="videos"][value="${id}"]`);
  if (checkbox) checkbox.checked = false;

  // Update the label styling
  const label = checkbox?.closest('.video-item');
  if (label) {
    label.classList.remove('bg-spindle-900', 'border-spindle-500');
    label.classList.add('bg-gray-700', 'border-transparent');
  }

  updateSelectedList();
}

function updateVideoOrderInputs() {
  const container = document.getElementById('video-order-inputs');
  container.innerHTML = '';

  // Remove all existing video checkboxes from form submission
  document.querySelectorAll('input[name="videos"]').forEach(cb => {
    cb.name = 'videos-temp';
  });

  // Add hidden inputs in the correct order
  selectedOrder.forEach(id => {
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'videos';
    input.value = id;
    container.appendChild(input);
  });
}

// Initialize SortableJS
const sortable = new Sortable(document.getElementById('sortable-selected'), {
  animation: 150,
  handle: '.drag-handle',
  ghostClass: 'opacity-50',
  onEnd: function() {
    // Update order based on new positions
    const items = document.querySelectorAll('#sortable-selected .selected-item');
    selectedOrder.length = 0;
    items.forEach(item => {
      selectedOrder.push(item.dataset.id);
    });
    updateSelectedList();
  }
});

// Sync color inputs
document.getElementById('primaryColor').addEventListener('input', function() {
  document.getElementById('primaryColorText').value = this.value;
});

// Update checkbox label styling on change
document.querySelectorAll('input[name="videos"], input[name="videos-temp"]').forEach(cb => {
  cb.addEventListener('change', function() {
    const label = this.closest('.video-item');
    if (this.checked) {
      label.classList.remove('bg-gray-700', 'border-transparent');
      label.classList.add('bg-spindle-900', 'border-spindle-500');
    } else {
      label.classList.remove('bg-spindle-900', 'border-spindle-500');
      label.classList.add('bg-gray-700', 'border-transparent');
    }
  });
});

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  updateSelectedList();
});
</script>

<%- include('../../partials/admin-footer') %>
