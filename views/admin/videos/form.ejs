<%- include('../../partials/admin-header') %>

<!-- Header -->
<div class="mb-6">
  <a href="/admin/videos" class="text-gray-400 hover:text-white flex items-center mb-4">
    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to Videos
  </a>
  <h1 class="text-3xl font-bold text-white"><%= video ? 'Edit Video' : 'Add Video' %></h1>
</div>

<!-- Error Message -->
<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-6 p-4 rounded-lg bg-red-900 text-red-300">
    <%= error %>
  </div>
<% } %>

<!-- Form -->
<div class="bg-gray-800 rounded-lg shadow">
  <form action="<%= action %>" method="<%= method %>" class="p-6 space-y-6">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Client -->
      <div>
        <label for="client" class="block text-sm font-medium text-gray-300 mb-1">Client *</label>
        <input type="text" name="client" id="client" required
               value="<%= video ? video.client : '' %>"
               list="client-list"
               class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
               placeholder="Client name">
        <datalist id="client-list">
          <% clients.forEach(function(c) { %>
            <option value="<%= c %>">
          <% }); %>
        </datalist>
      </div>

      <!-- Project -->
      <div>
        <label for="project" class="block text-sm font-medium text-gray-300 mb-1">Project *</label>
        <input type="text" name="project" id="project" required
               value="<%= video ? video.project : '' %>"
               class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
               placeholder="Project name">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Category -->
      <div>
        <label for="category" class="block text-sm font-medium text-gray-300 mb-1">Category</label>
        <input type="text" name="category" id="category"
               value="<%= video ? (video.category || '') : '' %>"
               list="category-list"
               class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
               placeholder="e.g., Commercial, Social, Internal...">
        <datalist id="category-list">
          <% categories.forEach(function(cat) { %>
            <% if (cat) { %>
              <option value="<%= cat.charAt(0).toUpperCase() + cat.slice(1) %>">
            <% } %>
          <% }); %>
        </datalist>
      </div>

      <!-- Date -->
      <div>
        <label for="date" class="block text-sm font-medium text-gray-300 mb-1">Date</label>
        <input type="date" name="date" id="date"
               value="<%= video ? new Date(video.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>"
               class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500">
      </div>
    </div>

    <!-- Embed ID -->
    <div>
      <label for="embedId" class="block text-sm font-medium text-gray-300 mb-1">Mux Playback ID *</label>
      <input type="text" name="embedId" id="embedId" required
             value="<%= video ? video.embedId : '' %>"
             class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 font-mono placeholder-gray-400"
             placeholder="e.g., DS00Spx1CV902MCtPj5WknGlR100V0...">
      <p class="mt-1 text-sm text-gray-400">The playback ID from your Mux dashboard</p>
    </div>

    <!-- Title -->
    <div>
      <label for="title" class="block text-sm font-medium text-gray-300 mb-1">Title</label>
      <input type="text" name="title" id="title"
             value="<%= video ? (video.title || '') : '' %>"
             class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
             placeholder="Video title (optional)">
    </div>

    <!-- Description -->
    <div>
      <label for="description" class="block text-sm font-medium text-gray-300 mb-1">Description</label>
      <textarea name="description" id="description" rows="3"
                class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
                placeholder="Video description (optional)"><%= video ? (video.description || '') : '' %></textarea>
    </div>

    <!-- Tags -->
    <div>
      <label for="tags" class="block text-sm font-medium text-gray-300 mb-1">Tags / Skills</label>
      <input type="text" name="tags" id="tags"
             value="<%= video ? video.tags.join(', ') : '' %>"
             class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400"
             placeholder="commercial, animation, vfx, motion graphics...">
      <p class="mt-1 text-sm text-gray-400">Comma-separated list of tags</p>
      <% if (tags.length > 0) { %>
        <div class="mt-2 flex flex-wrap gap-1">
          <span class="text-xs text-gray-400 mr-2">Existing tags:</span>
          <% tags.forEach(function(t) { %>
            <button type="button" onclick="addTag('<%= t %>')"
                    class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-700 text-gray-300 hover:bg-gray-600 cursor-pointer"
                    style="text-transform: capitalize;">
              <%= t %>
            </button>
          <% }); %>
        </div>
      <% } %>
    </div>

    <% if (video) { %>
      <!-- Active Status -->
      <div class="flex items-center">
        <input type="checkbox" name="isActive" id="isActive"
               <%= video.isActive ? 'checked' : '' %>
               class="h-4 w-4 text-spindle-600 focus:ring-spindle-500 bg-gray-700 border-gray-600 rounded">
        <label for="isActive" class="ml-2 text-sm text-gray-300">Active (visible in presentations)</label>
      </div>

      <!-- Preview -->
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-2">Preview</label>
        <div class="aspect-video bg-gray-900 rounded-lg overflow-hidden max-w-xl">
          <mux-player
            playback-id="<%= video.embedId %>"
            metadata-video-title="<%= video.title || video.project %>"
            accent-color="#6a94c7"
            style="width: 100%; height: 100%;"
          ></mux-player>
        </div>
      </div>
    <% } %>

    <!-- Submit -->
    <div class="flex justify-end space-x-4 pt-4 border-t border-gray-700">
      <a href="/admin/videos" class="px-4 py-2 border border-gray-600 rounded-lg text-gray-300 hover:bg-gray-700">Cancel</a>
      <button type="submit" class="px-6 py-2 bg-spindle-600 text-white rounded-lg hover:bg-spindle-700">
        <%= video ? 'Update Video' : 'Add Video' %>
      </button>
    </div>

  </form>
</div>

<script src="https://unpkg.com/@mux/mux-player"></script>
<script>
function addTag(tag) {
  const input = document.getElementById('tags');
  const currentTags = input.value.split(',').map(t => t.trim()).filter(t => t);
  if (!currentTags.includes(tag)) {
    currentTags.push(tag);
    input.value = currentTags.join(', ');
  }
}
</script>

<%- include('../../partials/admin-footer') %>
