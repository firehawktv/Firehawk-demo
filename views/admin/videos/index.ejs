<%- include('../../partials/admin-header') %>

<!-- Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-bold text-white">Videos</h1>
    <p class="mt-1 text-gray-400"><%= pagination.total %> videos in library</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <form action="/admin/videos/sync-mux" method="POST" class="inline">
      <button type="submit" id="sync-btn"
              class="bg-gray-700 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        Sync from Mux
      </button>
    </form>
    <a href="/admin/videos/new" class="bg-spindle-600 text-white px-4 py-2 rounded-lg hover:bg-spindle-700 transition-colors flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      Add Video
    </a>
  </div>
</div>

<!-- Filters -->
<div class="bg-gray-800 rounded-lg shadow mb-6 p-4">
  <form id="filter-form" method="GET" action="/admin/videos">
    <div class="flex flex-wrap gap-4 items-start">

      <!-- Search -->
      <div class="flex-1 min-w-[180px]">
        <label class="block text-sm font-medium text-gray-300 mb-1">Search</label>
        <input id="search-input" type="text" name="search" value="<%= filters.search || '' %>"
          placeholder="Search videos..."
          class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400">
      </div>

      <!-- Client -->
      <div class="min-w-[140px]">
        <label class="block text-sm font-medium text-gray-300 mb-1">Client</label>
        <select name="client" multiple size="<%= Math.min(Math.max(clients.length, 2), 6) %>"
          onchange="document.getElementById('filter-form').submit()"
          class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-1.5 focus:ring-spindle-500 focus:border-spindle-500">
          <% clients.forEach(function(c) { %>
            <option value="<%= c %>" <%= (filters.client || []).includes(c) ? 'selected' : '' %>><%= c %></option>
          <% }); %>
        </select>
      </div>

      <!-- Tag -->
      <div class="min-w-[140px]">
        <label class="block text-sm font-medium text-gray-300 mb-1">Tag</label>
        <select name="tag" multiple size="<%= Math.min(Math.max(tags.length, 2), 6) %>"
          onchange="document.getElementById('filter-form').submit()"
          class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-1.5 focus:ring-spindle-500 focus:border-spindle-500">
          <% tags.forEach(function(t) { %>
            <option value="<%= t %>" <%= (filters.tag || []).includes(t) ? 'selected' : '' %>
              style="text-transform: capitalize;"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
          <% }); %>
        </select>
      </div>

      <!-- Category -->
      <div class="min-w-[140px]">
        <label class="block text-sm font-medium text-gray-300 mb-1">Category</label>
        <select name="category" multiple size="<%= Math.min(Math.max(categories.length, 2), 6) %>"
          onchange="document.getElementById('filter-form').submit()"
          class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-1.5 focus:ring-spindle-500 focus:border-spindle-500">
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= (filters.category || []).includes(cat) ? 'selected' : '' %>
              style="text-transform: capitalize;"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
          <% }); %>
        </select>
      </div>

      <!-- Sort -->
      <div class="min-w-[140px]">
        <label class="block text-sm font-medium text-gray-300 mb-1">Sort by</label>
        <select name="sort"
          onchange="document.getElementById('filter-form').submit()"
          class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500">
          <option value="createdAt" <%= (filters.sort || 'createdAt') === 'createdAt' ? 'selected' : '' %>>Date Added</option>
          <option value="date" <%= filters.sort === 'date' ? 'selected' : '' %>>Project Date</option>
        </select>
      </div>

      <!-- Clear -->
      <div class="flex items-end">
        <a href="/admin/videos" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-500 text-sm">Clear</a>
      </div>

    </div>
  </form>
</div>

<!-- Videos List -->
<div class="space-y-2">

  <!-- Desktop column headers -->
  <div class="hidden md:grid items-center gap-4 px-4 pb-2 text-xs font-semibold text-gray-500 uppercase tracking-wider border-b border-gray-700"
       style="grid-template-columns: 6rem 11rem 1fr 10rem 7.5rem 6rem">
    <div></div>
    <div>Client</div>
    <div>Title</div>
    <div>Tags</div>
    <div>Date</div>
    <div></div>
  </div>

  <% videos.forEach(function(video) { %>

    <!-- Mobile card (hidden on md+) -->
    <div class="md:hidden bg-gray-800 rounded-lg p-4 flex items-center gap-4 hover:bg-gray-750 transition-colors">
      <div class="flex-shrink-0 w-24 h-16 bg-gray-700 rounded-lg overflow-hidden">
        <img src="https://image.mux.com/<%= video.embedId %>/thumbnail.jpg?width=160<%= video.thumbnail != null ? '&time=' + video.thumbnail : '' %>"
             alt="<%= video.title || video.project %>"
             class="w-full h-full object-cover"
             onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%239ca3af%22%3E%3Cpath d=%22M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z%22/%3E%3C/svg%3E'">
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-white font-medium truncate" title="<%= video.title || video.project %>">
          <%= video.title || video.project %>
        </div>
        <div class="text-gray-400 text-sm truncate">
          <%= video.client %><% if (video.agency) { %> <span class="text-gray-500">· <%= video.agency %></span><% } %>
        </div>
        <div class="flex flex-wrap gap-1 mt-1">
          <% if (video.category) { %>
            <span class="px-2 py-0.5 bg-spindle-600 text-white text-xs rounded-full" style="text-transform: capitalize;"><%= video.category %></span>
          <% } %>
          <% (video.tags || []).slice(0, 2).forEach(function(tag) { %>
            <span class="px-2 py-0.5 bg-gray-700 text-gray-300 text-xs rounded-full" style="text-transform: capitalize;"><%= tag %></span>
          <% }); %>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <% if (video.showOnSite) { %>
          <span class="text-green-400 p-2" title="Published to firehawk.tv">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12h20"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
            </svg>
          </span>
        <% } %>
        <a href="/admin/videos/<%= video._id %>/edit" class="text-gray-400 hover:text-white p-2" title="Edit">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </a>
        <form action="/admin/videos/<%= video._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this video?')">
          <button type="submit" class="text-gray-400 hover:text-red-400 p-2" title="Delete">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- Desktop row (hidden on mobile) -->
    <div class="hidden md:grid items-center gap-4 px-4 py-3 bg-gray-800 rounded-lg hover:bg-gray-750 transition-colors"
         style="grid-template-columns: 6rem 11rem 1fr 10rem 7.5rem 6rem">

      <!-- Thumbnail -->
      <div class="w-24 h-16 bg-gray-700 rounded-lg overflow-hidden flex-shrink-0">
        <img src="https://image.mux.com/<%= video.embedId %>/thumbnail.jpg?width=160<%= video.thumbnail != null ? '&time=' + video.thumbnail : '' %>"
             alt="<%= video.title || video.project %>"
             class="w-full h-full object-cover"
             onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%239ca3af%22%3E%3Cpath d=%22M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z%22/%3E%3C/svg%3E'">
      </div>

      <!-- Client -->
      <div class="min-w-0">
        <div class="text-gray-200 text-sm font-medium truncate"><%= video.client %></div>
        <% if (video.agency) { %>
          <div class="text-gray-500 text-xs truncate"><%= video.agency %></div>
        <% } %>
      </div>

      <!-- Title -->
      <div class="min-w-0">
        <div class="text-white font-medium truncate" title="<%= video.title || video.project %>">
          <%= video.title || video.project %>
        </div>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-1">
        <% if (video.category) { %>
          <span class="px-2 py-0.5 bg-spindle-600 text-white text-xs rounded-full" style="text-transform: capitalize;"><%= video.category %></span>
        <% } %>
        <% (video.tags || []).slice(0, 2).forEach(function(tag) { %>
          <span class="px-2 py-0.5 bg-gray-700 text-gray-300 text-xs rounded-full" style="text-transform: capitalize;"><%= tag %></span>
        <% }); %>
      </div>

      <!-- Date -->
      <div class="text-gray-400 text-sm whitespace-nowrap">
        <% if (video.date) { %>
          <%= new Date(video.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
        <% } else { %>
          <span class="text-gray-600">—</span>
        <% } %>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-1 justify-end">
        <% if (video.showOnSite) { %>
          <span class="text-green-400 p-1" title="Published to firehawk.tv">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12h20"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
            </svg>
          </span>
        <% } %>
        <a href="/admin/videos/<%= video._id %>/edit" class="text-gray-400 hover:text-white p-1" title="Edit">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </a>
        <form action="/admin/videos/<%= video._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this video?')">
          <button type="submit" class="text-gray-400 hover:text-red-400 p-1" title="Delete">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </form>
      </div>

    </div>

  <% }); %>

  <% if (videos.length === 0) { %>
    <div class="bg-gray-800 rounded-lg p-12 text-center text-gray-400">
      No videos found. <a href="/admin/videos/new" class="text-spindle-400 hover:text-spindle-300">Add your first video</a>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<% if (pagination.totalPages > 1) { %>
  <div class="mt-6 flex justify-center">
    <nav class="flex items-center space-x-2">
      <% for (let i = 1; i <= pagination.totalPages; i++) { %>
        <% const fc = Array.isArray(filters.client) ? filters.client : []; %>
        <% const ft = Array.isArray(filters.tag) ? filters.tag : []; %>
        <% const fcat = Array.isArray(filters.category) ? filters.category : []; %>
        <a href="/admin/videos?page=<%= i %>&<%= fc.map(c => 'client=' + encodeURIComponent(c)).join('&') %>&<%= ft.map(t => 'tag=' + encodeURIComponent(t)).join('&') %>&<%= fcat.map(c => 'category=' + encodeURIComponent(c)).join('&') %>&search=<%= encodeURIComponent(filters.search || '') %>&sort=<%= encodeURIComponent(filters.sort || 'createdAt') %>"
           class="px-3 py-2 rounded-lg <%= pagination.page === i ? 'bg-spindle-600 text-white' : 'bg-gray-800 text-gray-300 hover:bg-gray-700' %>">
          <%= i %>
        </a>
      <% } %>
    </nav>
  </div>
<% } %>

<script>
(function () {
  var input = document.getElementById('search-input');
  var timer;
  input.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      document.getElementById('filter-form').submit();
    }, 400);
  });
})();
</script>

<%- include('../../partials/admin-footer') %>
