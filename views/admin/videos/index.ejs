<%- include('../../partials/admin-header') %>

<!-- Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-bold text-white">Videos</h1>
    <p class="mt-1 text-gray-400"><%= pagination.total %> videos in library</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <!-- Sync from Mux Button -->
    <form action="/admin/videos/sync-mux" method="POST" class="inline">
      <button type="submit" id="sync-btn"
              class="bg-gray-700 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition-colors flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        Sync from Mux
      </button>
    </form>
    <!-- Add Video Button -->
    <a href="/admin/videos/new" class="bg-spindle-600 text-white px-4 py-2 rounded-lg hover:bg-spindle-700 transition-colors flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      Add Video
    </a>
  </div>
</div>

<!-- Alerts -->
<% if (typeof success !== 'undefined' || typeof error !== 'undefined') { %>
  <% const msg = typeof success !== 'undefined' ? success : (typeof error !== 'undefined' ? error : ''); %>
  <% const isError = typeof error !== 'undefined'; %>
  <% if (msg) { %>
    <div class="mb-6 p-4 rounded-lg <%= isError ? 'bg-red-900 text-red-300' : 'bg-green-900 text-green-300' %>">
      <%= msg %>
    </div>
  <% } %>
<% } %>

<!-- Filters -->
<div class="bg-gray-800 rounded-lg shadow mb-6 p-4">
  <form method="GET" action="/admin/videos" class="flex flex-wrap gap-4">
    <div class="flex-1 min-w-[200px]">
      <label class="block text-sm font-medium text-gray-300 mb-1">Search</label>
      <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search videos..."
        class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400">
    </div>
    <div class="w-48">
      <label class="block text-sm font-medium text-gray-300 mb-1">Client</label>
      <select name="client" class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500">
        <option value="">All Clients</option>
        <% clients.forEach(function(c) { %>
          <option value="<%= c %>" <%= filters.client === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </div>
    <div class="w-48">
      <label class="block text-sm font-medium text-gray-300 mb-1">Tag</label>
      <select name="tag" class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500">
        <option value="">All Tags</option>
        <% tags.forEach(function(t) { %>
          <option value="<%= t %>" <%= filters.tag === t ? 'selected' : '' %> style="text-transform: capitalize;"><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
        <% }); %>
      </select>
    </div>
    <div class="flex items-end">
      <button type="submit" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-500">Filter</button>
    </div>
  </form>
</div>

<!-- Videos List -->
<div class="space-y-3">
  <% videos.forEach(function(video) { %>
    <!-- Video Card -->
    <div class="bg-gray-800 rounded-lg p-4 flex items-center gap-4 hover:bg-gray-750 transition-colors">
      <!-- Thumbnail -->
      <div class="flex-shrink-0 w-24 h-16 bg-gray-700 rounded-lg overflow-hidden">
        <img src="https://image.mux.com/<%= video.embedId %>/thumbnail.jpg?width=160"
             alt="<%= video.title || video.project %>"
             class="w-full h-full object-cover"
             onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%239ca3af%22%3E%3Cpath d=%22M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z%22/%3E%3C/svg%3E'">
      </div>

      <!-- Content -->
      <div class="flex-1 min-w-0">
        <div class="text-white font-medium truncate" title="<%= video.title || video.project %>">
          <%= video.title || video.project %>
        </div>
        <div class="text-gray-400 text-sm truncate" title="<%= video.client %>">
          <%= video.client %>
        </div>
        <% if (video.category) { %>
          <div class="flex flex-wrap gap-1 mt-1">
            <span class="px-2 py-0.5 bg-spindle-600 text-white text-xs rounded-full" style="text-transform: capitalize;"><%= video.category %></span>
          </div>
        <% } %>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <a href="/admin/videos/<%= video._id %>/edit" class="text-gray-400 hover:text-white p-2" title="Edit">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </a>
        <form action="/admin/videos/<%= video._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this video?')">
          <button type="submit" class="text-gray-400 hover:text-red-400 p-2" title="Delete">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  <% }); %>

  <% if (videos.length === 0) { %>
    <div class="bg-gray-800 rounded-lg p-12 text-center text-gray-400">
      No videos found. <a href="/admin/videos/new" class="text-spindle-400 hover:text-spindle-300">Add your first video</a>
    </div>
  <% } %>
</div>

<!-- Pagination -->
<% if (pagination.totalPages > 1) { %>
  <div class="mt-6 flex justify-center">
    <nav class="flex items-center space-x-2">
      <% for (let i = 1; i <= pagination.totalPages; i++) { %>
        <a href="/admin/videos?page=<%= i %>&client=<%= encodeURIComponent(filters.client || '') %>&tag=<%= encodeURIComponent(filters.tag || '') %>&search=<%= encodeURIComponent(filters.search || '') %>"
           class="px-3 py-2 rounded-lg <%= pagination.page === i ? 'bg-spindle-600 text-white' : 'bg-gray-800 text-gray-300 hover:bg-gray-700' %>">
          <%= i %>
        </a>
      <% } %>
    </nav>
  </div>
<% } %>

<%- include('../../partials/admin-footer') %>
