<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Firehawk Admin</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center">
  <div class="w-full max-w-sm px-4">

    <!-- Logo / Title -->
    <div class="text-center mb-8">
      <span class="text-3xl font-bold text-spindle-400">Firehawk</span>
      <span class="ml-2 text-gray-400 text-sm">CMS</span>
    </div>

    <!-- Card -->
    <div class="bg-gray-800 rounded-xl shadow-xl p-8">
      <h1 class="text-xl font-semibold text-white mb-6">Admin Login</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-4 p-3 rounded-lg bg-red-900 text-red-300 text-sm">
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-4">
        <div>
          <label for="username" class="block text-sm font-medium text-gray-300 mb-1">Username</label>
          <input type="text" name="username" id="username" required autofocus
                 autocomplete="username"
                 class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500 placeholder-gray-400">
        </div>
        <div>
          <label for="password" class="block text-sm font-medium text-gray-300 mb-1">Password</label>
          <input type="password" name="password" id="password" required
                 autocomplete="current-password"
                 class="w-full bg-gray-700 border border-gray-600 text-white rounded-lg px-3 py-2 focus:ring-spindle-500 focus:border-spindle-500">
        </div>
        <button type="submit"
                class="w-full bg-spindle-600 text-white py-2 px-4 rounded-lg hover:bg-spindle-700 transition-colors font-medium mt-2">
          Sign In
        </button>
      </form>
    </div>

  </div>
</body>
</html>
