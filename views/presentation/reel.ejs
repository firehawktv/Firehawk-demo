<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= presentation.client %> - Video Presentation</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://unpkg.com/@mux/mux-player"></script>
  <style>
    :root {
      --accent-color: <%= presentation.primaryColor || '#6a94c7' %>;
      --bg-color: <%= presentation.theme === 'light' ? '#ffffff' : '#111827' %>;
      --text-color: <%= presentation.theme === 'light' ? '#111827' : '#ffffff' %>;
      --text-muted: <%= presentation.theme === 'light' ? '#6b7280' : '#9ca3af' %>;
      --card-bg: <%= presentation.theme === 'light' ? '#f9fafb' : '#1f2937' %>;
      --border-color: <%= presentation.theme === 'light' ? '#e5e7eb' : '#374151' %>;
    }
    body {
      background-color: var(--bg-color);
      color: var(--text-color);
    }
    .accent { color: var(--accent-color); }
    .accent-bg { background-color: var(--accent-color); }
    .accent-border { border-color: var(--accent-color); }
    .card-bg { background-color: var(--card-bg); }
    .text-muted { color: var(--text-muted); }
    .border-themed { border-color: var(--border-color); }

    /* Thumbnail strip scrolling */
    .thumbnail-strip {
      scroll-behavior: smooth;
      scrollbar-width: thin;
      scrollbar-color: var(--accent-color) var(--card-bg);
    }
    .thumbnail-strip::-webkit-scrollbar {
      height: 6px;
    }
    .thumbnail-strip::-webkit-scrollbar-track {
      background: var(--card-bg);
      border-radius: 3px;
    }
    .thumbnail-strip::-webkit-scrollbar-thumb {
      background: var(--border-color);
      border-radius: 3px;
    }
    .thumbnail-strip::-webkit-scrollbar-thumb:hover {
      background: var(--accent-color);
    }

    /* Thumbnail selection */
    .thumbnail {
      transition: all 0.2s ease;
      opacity: 0.6;
    }
    .thumbnail:hover {
      opacity: 0.9;
    }
    .thumbnail.active {
      opacity: 1;
      border-color: var(--accent-color);
      transform: scale(1.05);
    }

    /* Main player container */
    .main-player-container {
      max-height: calc(100vh - 300px);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header -->
  <header class="py-6 px-4 sm:px-6 lg:px-8 border-b border-themed flex-shrink-0">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-4">
          <% if (presentation.clientLogo) { %>
            <img src="<%= presentation.clientLogo %>" alt="<%= presentation.client %>" class="h-10 w-auto object-contain">
          <% } %>
          <div>
            <h1 class="text-xl sm:text-2xl font-bold"><%= presentation.client %></h1>
            <p class="text-muted text-sm">
              <%= new Date(presentation.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
          </div>
        </div>
      </div>

      <% if (presentation.message) { %>
        <div class="mt-4 p-3 card-bg rounded-lg border border-themed">
          <p class="text-muted text-sm leading-relaxed whitespace-pre-wrap"><%= presentation.message %></p>
        </div>
      <% } %>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 py-6 px-4 sm:px-6 lg:px-8 flex flex-col">
    <div class="max-w-7xl mx-auto w-full flex-1 flex flex-col">

      <!-- Main Video Player -->
      <div class="main-player-container flex-1 mb-6">
        <div class="w-full h-full bg-black rounded-xl overflow-hidden shadow-2xl" style="aspect-ratio: 16/9;">
          <div id="main-player" class="w-full h-full">
            <% if (videos.length > 0) { %>
              <mux-player
                playback-id="<%= videos[0].embedId %>"
                metadata-video-title="<%= videos[0].title || videos[0].project %>"
                accent-color="<%= presentation.primaryColor || '#6a94c7' %>"
                style="width: 100%; height: 100%;"
              ></mux-player>
            <% } %>
          </div>
        </div>

        <!-- Current video info -->
        <div class="mt-4 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
          <div>
            <h2 id="current-title" class="text-xl font-semibold"><%= videos.length > 0 ? (videos[0].title || videos[0].project) : '' %></h2>
            <p id="current-description" class="text-muted text-sm mt-1"><%= videos.length > 0 ? (videos[0].description || '') : '' %></p>
          </div>
          <div id="current-tags" class="flex flex-wrap gap-1">
            <% if (videos.length > 0 && videos[0].tags) { %>
              <% videos[0].tags.forEach(function(tag) { %>
                <span class="text-xs px-2 py-0.5 rounded-full border border-themed text-muted"><%= tag %></span>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Thumbnail Strip -->
      <div class="flex-shrink-0">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-medium text-muted uppercase tracking-wide">
            <span id="video-counter">1</span> of <%= videos.length %> videos
          </h3>
          <div class="flex gap-2">
            <button onclick="scrollThumbnails(-1)" class="p-2 card-bg rounded-lg border border-themed hover:border-gray-500 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>
            <button onclick="scrollThumbnails(1)" class="p-2 card-bg rounded-lg border border-themed hover:border-gray-500 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </div>

        <div id="thumbnail-strip" class="thumbnail-strip flex gap-3 overflow-x-auto pb-3">
          <% videos.forEach(function(video, index) { %>
            <button
              onclick="selectVideo(<%= index %>)"
              class="thumbnail flex-shrink-0 w-40 sm:w-48 rounded-lg overflow-hidden border-2 border-themed focus:outline-none <%= index === 0 ? 'active' : '' %>"
              data-index="<%= index %>"
            >
              <div class="aspect-video relative">
                <img src="https://image.mux.com/<%= video.embedId %>/thumbnail.jpg?width=320"
                     alt="<%= video.title || video.project %>"
                     class="w-full h-full object-cover"
                     loading="lazy"
                     onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%234b5563%22%3E%3Cpath d=%22M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z%22/%3E%3C/svg%3E'">
                <div class="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-20 transition-all flex items-center justify-center">
                  <div class="w-10 h-10 rounded-full bg-white bg-opacity-90 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                    <svg class="w-5 h-5 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="p-2 card-bg">
                <p class="text-sm font-medium truncate text-left"><%= video.title || video.project %></p>
              </div>
            </button>
          <% }); %>
        </div>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="py-4 px-4 text-center text-muted text-sm border-t border-themed flex-shrink-0">
    <p>Presented by <span class="accent font-semibold">Firehawk</span></p>
  </footer>

  <script>
    const videos = <%- JSON.stringify(videos.map(v => ({
      id: v._id,
      embedId: v.embedId,
      title: v.title || v.project,
      description: v.description || '',
      tags: v.tags || []
    }))) %>;

    let currentIndex = 0;

    function selectVideo(index) {
      currentIndex = index;
      const video = videos[index];

      // Update player
      const playerContainer = document.getElementById('main-player');
      playerContainer.innerHTML = `
        <mux-player
          playback-id="${video.embedId}"
          metadata-video-title="${video.title}"
          accent-color="<%= presentation.primaryColor || '#6a94c7' %>"
          autoplay
          style="width: 100%; height: 100%;"
        ></mux-player>
      `;

      // Update info
      document.getElementById('current-title').textContent = video.title;
      document.getElementById('current-description').textContent = video.description;
      document.getElementById('video-counter').textContent = index + 1;

      // Update tags
      const tagsContainer = document.getElementById('current-tags');
      tagsContainer.innerHTML = video.tags.map(tag =>
        `<span class="text-xs px-2 py-0.5 rounded-full border border-themed text-muted">${tag}</span>`
      ).join('');

      // Update thumbnail selection
      document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
        thumb.classList.toggle('active', i === index);
      });

      // Scroll thumbnail into view
      const thumbnail = document.querySelector(`[data-index="${index}"]`);
      if (thumbnail) {
        thumbnail.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    }

    function scrollThumbnails(direction) {
      const strip = document.getElementById('thumbnail-strip');
      const scrollAmount = 200;
      strip.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft' && currentIndex > 0) {
        selectVideo(currentIndex - 1);
      }
      if (e.key === 'ArrowRight' && currentIndex < videos.length - 1) {
        selectVideo(currentIndex + 1);
      }
    });
  </script>
</body>
</html>
