<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presentation Expired | Firehawk</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center">
  <div class="text-center px-4">
    <div class="text-gray-500 mb-6">
      <svg class="w-20 h-20 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-white mb-4">Presentation Expired</h1>
    <p class="text-gray-400 mb-2">The presentation for <span class="text-white font-medium"><%= client %></span> is no longer available.</p>
    <p class="text-gray-500 mb-8">Please contact the sender for an updated link.</p>
  </div>
</body>
</html>
