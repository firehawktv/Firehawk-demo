<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Firehawk</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center">
  <div class="text-center px-4">
    <div class="text-red-500 mb-6">
      <svg class="w-20 h-20 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-white mb-4">Something went wrong</h1>
    <p class="text-gray-400 mb-8"><%= message %></p>
    <a href="/" class="px-6 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors inline-block">
      Go Home
    </a>
  </div>
</body>
</html>
